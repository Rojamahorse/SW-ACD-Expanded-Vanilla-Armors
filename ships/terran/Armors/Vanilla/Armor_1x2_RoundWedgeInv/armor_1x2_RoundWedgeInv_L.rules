Part : &<../base_part_terran.rules>/Part
{
	NameKey = "Parts/EXPVArmor1x2RoundWedgeInvL"
	IconNameKey = "Parts/EXPVArmor1x2RoundWedgeInvLIcon"
	ID = SW.expanded_v_armor_1x2_RoundWedgeInv_L
	FlipWhenLoadingIDs = [SW.expanded_v_armor_1x2_RoundWedgeInv_R /*, Kroom.Armor_1x2_RoundWedgeInv_R, Armor_1x2_RoundWedgeInvR, SW.Armor1x2_RoundWedgeInvR, Armor1x2_RoundWedgeInvR*/]
	
	MaxHealth = floor((&<../base_part_terran.rules>/MaxHealth) * (&~/Scale))	
	InitialPenetrationResistance = ceil((&<../base_part_terran.rules>/InitialPenetrationResistance) * (&~/Scale) * 0.9)

	Density = (&<../base_part_terran.rules>/Density)

    Resources
    [
		[steel, ceil((&<../base_part_terran.rules>/Cost)*(&~/Scale))]
    ]
	Size = [1, 2]
	IsFlippable = true
	AllowedContiguity = [Right, Bottom]
	UnderlyingPart = SW.expanded_v_structure_1x2_RoundWedgeInv_L

	ExternalWallsByCell
	[
		{
			Key = [0, 0]
			Value = [TopRight, Right]
		}
		{
			Key = [0, 1]
			Value = [Right, BottomRight, Bottom, BottomLeft]
		}
	]
	InternalWallsByCell
	[
		{
			Key = [0, 0]
			Value = [BottomLeft, Left, TopLeft, Top]
		}
		{
			Key = [0, 1]
			Value = [Left, TopLeft]
		}
	]
	VirtualInternalCells
	[
		{ExternalCell=[0, -1]; InternalCell=[1, 0]}
		{ExternalCell=[-1, 1]; InternalCell=[0, 2]}
	]

	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 64]
	}
	Components : ^/0/Components, &<roofs1x2.rules>
	{
		RoofArtOptionToggle
		{
			Type = UIToggle
			ToggleID = "SW.5.armor_roof_type"
			Default = 0
			AvailableChoices = [0,1,2,3,4]
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}

		Collider
		{
			Type = PolygonCollider
			Vertices
			[
				[1, 0.2]
				[1, 2]
				[0.1, 2]
			]
		}

		EmpAbsorber
		{
			Type = ExplosiveResourceDrainSink
			ResourceType = battery
			AbsorbsResourceDrain = ceil((&~/Part/MaxHealth)/4) // 1100
			RecoveryRate = ceil(&AbsorbsResourceDrain) * 0.1
		}

		Graphics
		{
			Type = Graphics
			Location = [0.5, 1]
			Floor // This is needed so that armor shows up in ship ghosts.
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "armor.png"
						Size = [1, 2]
					}
					{
						File = "armor_33.png"
						Size = [1, 2]
					}
					{
						File = "armor_66.png"
						Size = [1, 2]
					}
				]
			}
			Walls
			{
				Layer = "external_walls"
				DamageLevels
				[
					{
						File = "armor.png"
						NormalsFile = "external_wall_normals.png"
						Size = [1, 2]
					}
					{
						File = "armor_33.png"
						NormalsFile = "external_wall_33_normals.png"
						Size = [1, 2]
					}
					{
						File = "armor_66.png"
						NormalsFile = "external_wall_66_normals.png"
						Size = [1, 2]
					}
				]
			}
		}

		ConstructionStructureSprite : ^/0/ConstructionStructureSprite
		{
			Location = [.5, 1]
			AtlasSprite = &<../../../Structures/Vanilla/Structure_1x2_RoundWedgeInv\Structure_1x2_RoundWedgeInv_L.rules>/Part/Components/Graphics/Floor/DamageLevels/0
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyedDry
			Location = [.5, 1]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 2]
		}
	}

	Stats
	{
		EMPResist = (&~/Part/Components/EmpAbsorber/AbsorbsResourceDrain) / 1000
		AOEResist = (&~/Part/DamageResistances/explosive) * 100
	}
}
Scale = (1*6/8)
