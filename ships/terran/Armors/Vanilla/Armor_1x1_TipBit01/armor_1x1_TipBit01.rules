Part : &<../base_part_terran.rules>/Part
{
	NameKey = "Parts/EXPVArmor1x1TipBit01"
	IconNameKey = "Parts/EXPVArmor1x1TipBit01Icon"
	ID = SW.expanded_v_armor_1x1_TipBit01

	MaxHealth = floor((&<../base_part_terran.rules>/MaxHealth) * (&~/Scale))	
	InitialPenetrationResistance = ceil((&<../base_part_terran.rules>/InitialPenetrationResistance) * (&~/Scale) * 0.9)

	Density = (&<../base_part_terran.rules>/Density)

    Resources
    [
     	[steel, ceil((&<../base_part_terran.rules>/Cost)*(&~/Scale))]
    ]
	Size = [1, 1]
	AllowedContiguity = [Bottom]
	UnderlyingPart = SW.expanded_v_structure_1x1_TipBit01

	ExternalWalls = [None]
	InternalWalls = [BottomLeft, Left, TopLeft, Top, TopRight, Right, BottomRight]
	//AllowedDoorLocations = []
	//GeneratorRequiresDoor = false
	//GenerateRectCollider = false
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}
	Components : ^/0/Components, &<roofs.rules>
	{
		RoofArtOptionToggle
		{
			Type = UIToggle
			ToggleID = "SW.5.armor_roof_type"
			Default = 0
			AvailableChoices = [0,1,2,3,4]
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}

		Collider
		{
			Type = PolygonCollider
			Vertices
			[
				[.26, 0.5]
				[.74, 0.5]
				[0.78, 1]
				[0.22, 1]
			]
		}

		EmpAbsorber
		{
			Type = ExplosiveResourceDrainSink
			ResourceType = battery
			AbsorbsResourceDrain = ceil((&~/Part/MaxHealth)/4) // 375
			RecoveryRate = ceil(&AbsorbsResourceDrain) * 0.1
		}

		Graphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			Floor // This is needed so that armor shows up in ship ghosts.
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "armor.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_33.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_66.png"
						Size = [1, 1]
						UVRotation = 0
					}
				]
			}
			Walls
			{
				Layer = "external_walls"
				DamageLevels
				[
					{
						File = "armor.png"
						NormalsFile = "external_wall_normals.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_33.png"
						NormalsFile = "external_wall_33_normals.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_66.png"
						NormalsFile = "external_wall_66_normals.png"
						Size = [1, 1]
						UVRotation = 0
					}
				]
			}

		// ---------- BLUEPRINT BORDERS ----------
		BlueprintBorder_Rot0   // external bottom neighbor (rotation 0)
		{
		    Type = BlueprintBlendSprite
		    OnlyWithRotation = 0
		    Location = [0.5, 1.5]
		    BlendCheckRectType = Physical
		    AllowUndefinedBlendSprites = true
		    RequireExternalWallsToBlend = true
		    AmbiguousSprites
		    [
		        {
		            SituationCode = "*****0**"           // bottom edge present
		            AllowRotation = false
		            DamageLevels
		            [
		                { File = "../Borders/blueprints_split025.png"; Size=[1,1]; UVRotation=2 }
		            ]
		        }
		    ]
		}
