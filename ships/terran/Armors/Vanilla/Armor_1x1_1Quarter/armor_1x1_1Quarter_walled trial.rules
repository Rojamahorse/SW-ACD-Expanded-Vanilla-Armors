Part : &<../base_part_terran.rules>/Part
{
	NameKey = "Parts/EXPVArmor1x11Quarter"
	IconNameKey = "Parts/EXPVArmor1x11QuarterIcon"
	ID = SW.expanded_v_armor_1x1_1Quarter
	//OtherIDs = [Armor_1x1_1Quarter, Kroom.Armor_1x1_1Quarter]
	
	//DescriptionKey = "Parts/ExpVArmorDesc"
	//EditorReplacementPartID = ""
	MaxHealth = floor((&<../base_part_terran.rules>/MaxHealth) * (&~/Scale))	
	InitialPenetrationResistance = ceil((&<../base_part_terran.rules>/InitialPenetrationResistance) * (&~/Scale) * 0.9)

	Density = (&<../base_part_terran.rules>/Density)

	Resources
	[
	 	[steel, ceil((&<../base_part_terran.rules>/Cost)*(&~/Scale))]
	]
	//FractionalCostToRepair = 50%
	//AIValueFactor = 0
	Size = [1, 1]
	AllowedContiguity = [Top, Right, Bottom]
	UnderlyingPart = cosmoteer.structure_tri
	//SelectionTypeID = "armor"
	//MaxHealth = 1500 //4000/4*1,5
	//ExplosiveDamageAbsorption = 100%
	//ExplosiveDamageResistance = 50%
	//TypeCategories = [armor]
	//ReceivableBuffs : ^/0/ReceivableBuffs []
	//Flammable = false
	//UnderlyingPartPerTile = ""
	//UnderlyingPart = ""
	//CreatePartPerTileWhenGrabbed = ""
	//InitialPenetrationResistance = 6
	//ContinuingPenetrationResistance = &InitialPenetrationResistance
	//CrewSpeedFactor = 0
	//Density = 3
	//IsRotateable = true
	//IsWalled = true
	//IsSelfDestructible = false
	ExternalWalls = [TopRight, Right, BottomRight]
	InternalWalls = [TopLeft, Left, BottomLeft]
	VirtualInternalCells
	[
		{ExternalCell=[0, -1]; InternalCell=[1, 0]}
		{ExternalCell=[0, 1]; InternalCell=[1, 0]}
	]
	//AllowedDoorLocations = []
	//GeneratorRequiresDoor = false
	FlipHRotate = [2, 1, 0, 3]  
	FlipVRotate = [0, 3, 2, 1]  
	//GenerateRectCollider = false
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}
	Components : ^/0/Components, &<roofs.rules>
	{
		RoofArtOptionToggle
		{
			Type = UIToggle
			ToggleID = "SW.5.armor_roof_type"
			Default = 0
			AvailableChoices = [0,1,2,3,4]
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}


		Collider
		{
			Type = PolygonCollider
			Vertices
			[
				[0.75, 0]
				[1, 0]
				[1, 1]
				[0.75, 1]
			]
		}

		EmpAbsorber
		{
			Type = ExplosiveResourceDrainSink
			ResourceType = battery
			AbsorbsResourceDrain = ceil((&~/Part/MaxHealth)/4) // 350
			RecoveryRate = ceil(&AbsorbsResourceDrain) * 0.1
		}



//		RectQtr_TriTR : <rectqtr_tri_tr.rules>
//		{
//		    Type = BlendSprite
//		    Location = [0.5, -0.5]         // top-right corner
//		    BlendsWithCategories = [armor]  
//		}
//		RectQtr_TriBR : <rectqtr_tri_br.rules>
//		{
//		    Type = BlendSprite
//		    Location = [0.5, 1.5]          // bottom-right corner
//		    BlendsWithCategories = [armor]
//		}
//		RectQtr_TopBar : <rectqtr_bar_top.rules>
//		{
//		    Type = BlendSprite
//		    Location = [0.5, 0.5]          // center; nudge if needed
//		    BlendsWithCategories = [armor]
//		}
//		RectQtr_BotBar : <rectqtr_bar_bottom.rules>
//		{
//		    Type = BlendSprite
//		    Location = [0.22, 0.5]         // your bottom bar offset
//		    BlendsWithCategories = [armor]
//		}

		Graphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			// This is needed so that armor shows up in ship ghosts.
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "armor.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_33.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_66.png"
						Size = [1, 1]
						UVRotation = 0
					}
				]
			}
			Walls
			{
				Layer = "external_walls"
				DamageLevels
				[
					{
						File = "armor.png"
						NormalsFile = "external_wall_normals.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_33.png"
						NormalsFile = "external_wall_33_normals.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_66.png"
						NormalsFile = "external_wall_66_normals.png"
						Size = [1, 1]
						UVRotation = 0
					}
				]
			}

			//WallsBlend : <internal_walls.rules>
			//{
			//	Type = BlendSprite
			//	Location = [.5, .5]
			//	BlendsWithCategories = [corridor]
			//}
