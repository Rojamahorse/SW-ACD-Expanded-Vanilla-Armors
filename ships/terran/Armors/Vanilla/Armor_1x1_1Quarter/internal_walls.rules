	BASE_WALL_TEMPLATE
	{
	    Type  = BlendSprite
	    Layer = "walls"                       // change to "roofs" etc if needed
	    BlendCheckRectType = Physical
	    RequireExternalWallsToBlend = true
		AllowUndefinedBlendSprites = true
	    //RequireInternalWallsToBlend = true

	    // CRITICAL: keep flips predictable so we don't need *_Rev siblings:
    	FlipHRotate = [2, 1, 0, 3]
    	FlipVRotate = [0, 3, 2, 1]
		AmbiguousSprites
	    [
		]
	}
	//=== TRI_CAP_TOPRIGHT =====================================================
	// Location: top-right of the center tile. Adjust if your pivot differs.
	TRI_CAP_TR_r0 : BASE_WALL_TEMPLATE
	{
	    // Rotation 0 (base “up”)
	    OnlyWithRotation = 0
	    Location = [0.5, -0.5]
	    AmbiguousSprites
	    [
	        {
	            SituationCode = "*0******"    // T=0 (no neighbor above)
	            AllowRotation = false
	            DamageLevels
	            [
	                { File = "../Borders/tri_armor3x.png";  Size=[1,1]; UVRotation=0 }
	            ]
	        }
	    ]
	}

	TRI_CAP_TR_r1 : BASE_WALL_TEMPLATE
	{
	    // Rotation 1 (base “right”)
	    OnlyWithRotation = 1
	    Location = [0.5, -0.5]
	    AmbiguousSprites
	    [
	        {
	            SituationCode = "***0****"    // R=0
	            AllowRotation = false
	            DamageLevels
	            [
	                // If handedness looks off here, flip U:
	                { File = "../Borders/tri_armor3x.png";  Size=[1,1]; UVRotation=1; MirrorU=true; }
	            ]
	        }
	    ]
	}

	TRI_CAP_TR_r2 : BASE_WALL_TEMPLATE
	{
	    // Rotation 2 (base “down”)
	    OnlyWithRotation = 2
	    Location = [0.5, -0.5]
	    AmbiguousSprites
	    [
	        {
	            SituationCode = "*****0**"    // B=0
	            AllowRotation = false
	            DamageLevels
	            [
	                { File = "../Borders/tri_armor3x.png";  Size=[1,1]; UVRotation=2 }
	            ]
	        }
	    ]
	}

	TRI_CAP_TR_r3 : BASE_WALL_TEMPLATE
	{
	    // Rotation 3 (base “left”)
	    OnlyWithRotation = 3
	    Location = [0.5, -0.5]
	    AmbiguousSprites
	    [
	        {
	            SituationCode = "*******0"    // L=0
	            AllowRotation = false
	            DamageLevels
	            [
	                // If needed, toggle MirrorU to keep the long edge aligned to the short side:
	                { File = "../Borders/tri_armor3x.png";  Size=[1,1]; UVRotation=3; MirrorU=true }
	            ]
	        }
	    ]
	}
