Part : &<../base_part_terran.rules>/Part
{
	NameKey = "Parts/EXPVArmor1x1Wedge2Quarter"
	IconNameKey = "Parts/EXPVArmor1x1Wedge2QuarterIcon"
	ID = SW.expanded_v_armor_1x1_Wedge_2Quarter
	//OtherIDs = [Armor_1x1_Wedge_2Quarter, Kroom.Armor_1x1_Wedge_2Quarter]
	
	//DescriptionKey = "Parts/ExpVArmorDesc"
	//EditorReplacementPartID = ""
	MaxHealth = floor((&<../base_part_terran.rules>/MaxHealth) * (&~/Scale))	
	InitialPenetrationResistance = ceil((&<../base_part_terran.rules>/InitialPenetrationResistance) * (&~/Scale) * 0.9)

	Density = (&<../base_part_terran.rules>/Density)

    Resources
    [
     	[steel, ceil((&<../base_part_terran.rules>/Cost)*(&~/Scale))]
    ]
	Size = [1, 1]
	AllowedContiguity = [Right, Bottom]
	UnderlyingPart = SW.expanded_v_structure_1x1_Wedge_2Quarter

	ExternalWalls = [BottomRight]
	InternalWalls = [BottomLeft, Left, TopLeft, Top, TopRight]
	VirtualInternalCells
	[
		{ExternalCell=[0, 1]; InternalCell=[1, 0]}
		{ExternalCell=[1, 0]; InternalCell=[0, 1]}
	]
	//AllowedDoorLocations = []
	//GeneratorRequiresDoor = false
	FlipHRotate = [1, 0, 3, 2]
	FlipVRotate = [3, 2, 1, 0]
	//GenerateRectCollider = false
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}
	Components : ^/0/Components, &<roofs.rules>
	{
		RoofArtOptionToggle
		{
			Type = UIToggle
			ToggleID = "SW.5.armor_roof_type"
			Default = 0
			AvailableChoices = [0,1,2,3,4]
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}


		Collider
		{
			Type = PolygonCollider
			Vertices
			[
				[1, 0.5]
				[1, 1]
				[0.5, 1]
			]
		}

		EmpAbsorber
		{
			Type = ExplosiveResourceDrainSink
			ResourceType = battery
			AbsorbsResourceDrain = ceil((&~/Part/MaxHealth)/4) // 185
			RecoveryRate = ceil(&AbsorbsResourceDrain) * 0.1
		}
		
		Graphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			Floor // This is needed so that armor shows up in ship ghosts.
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "armor.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_33.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_66.png"
						Size = [1, 1]
						UVRotation = 0
					}
				]
			}
			Walls
			{
				Layer = "external_walls"
				DamageLevels
				[
					{
						File = "armor.png"
						NormalsFile = "external_wall_normals.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_33.png"
						NormalsFile = "external_wall_33_normals.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_66.png"
						NormalsFile = "external_wall_66_normals.png"
						Size = [1, 1]
						UVRotation = 0
					}
				]
			}
		}

		ConstructionStructureSprite : ^/0/ConstructionStructureSprite
		{
			AtlasSprite = &<../../../Structures/Vanilla/Structure_1x1_Wedge_2Quarter\Structure_1x1_Wedge_2Quarter.rules>/Part/Components/Graphics/Floor/DamageLevels/0
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyedDry
			Location = [.5, .5]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 1]
		}
	}

	Stats
	{
		EMPResist = (&~/Part/Components/EmpAbsorber/AbsorbsResourceDrain) / 1000
		AOEResist = (&~/Part/DamageResistances/explosive) * 100
	}
}
Scale = (1*2/8)
